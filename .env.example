# Server-side only; required by the application. Use deployment-specific DB credentials.
DATABASE_URL="postgresql://postgres:password@localhost:5432/kiruhak_db?schema=public"

# Telegram (server-side only; required only for corresponding Telegram features)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_USERNAME=""
ADMIN_TELEGRAM_ID=""

# Server-side only; required in production for trusted bot endpoints.
# Use a unique random value; never reuse the auth signing secret.
BOT_SECRET=""
# Server-side only; required in production. At least 32 random characters.
AUTH_TOKEN_SECRET=""
# Comma-separated exact origins; no paths or trailing slashes. Empty means
# localhost:3000 in development and no cross-origin access in production.
CORS_ORIGINS="http://localhost:3000"
ALLOW_SELF_TOPUP="false"

# Public
NUXT_PUBLIC_SITE_URL="https://kiruhak11.ru"
YANDEX_METRIKA_ID=""
